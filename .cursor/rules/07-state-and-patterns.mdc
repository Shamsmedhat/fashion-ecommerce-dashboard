## Error Handling

### AppError class

```typescript
// src/utils/app-errors.ts
export type AppErrorType = "authentication" | "authorization" | "general";

export class AppError extends Error {
  public readonly statusCode: number;
  public readonly type: AppErrorType;

  constructor(message: string, statusCode: number, type: AppErrorType = "general") {
    super(message);
    this.name = "AppError";
    this.statusCode = statusCode;
    this.type = type;
  }

  get isAuthentication() { return this.type === "authentication"; }
  get isAuthorization() { return this.type === "authorization"; }
}
```

### getErrorMessage utility

```typescript
// src/utils/catch-error.ts
import { AppError } from "./app-errors";

export function getErrorMessage(error: unknown): string {
  if (error instanceof AppError) return error.message;
  if (error instanceof Error) return error.message;
  if (typeof error === "string") return error;
  return "An unexpected error occurred";
}
```

### Services always throw AppError

```typescript
// ✅ Good
if (!response.ok) {
  const errorData: ErrorResponse = await response.json().catch(() => ({
    status: "error" as const,
    message: `Request failed with status ${response.status}`,
  }));
  throw new AppError(errorData.message, response.status);
}

// ❌ Bad
if (!response.ok) {
  throw new Error("Something went wrong");
}
```

