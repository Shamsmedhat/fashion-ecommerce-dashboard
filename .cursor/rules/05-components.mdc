## Suspense (React 19)

React 19 supports Suspense with async components and `use()`. Wrap data-fetching components:

```typescript
// src/routes/products/index.tsx
import { Suspense } from "react";
import { ProductListSkeleton } from "@/components/skeletons/products/product-list.skeleton";
import { ProductList } from "@/features/products/components/product-list";

function ProductsPage() {
  return (
    <section>
      <Suspense fallback={<ProductListSkeleton />}>
        <ProductList />
      </Suspense>
    </section>
  );
}
```

---

## Lazy Loading

Use `React.lazy` for heavy components not needed on initial render:

```typescript
import { lazy, Suspense } from "react";
import { ChartSkeleton } from "@/components/skeletons/shared/chart.skeleton";

const HeavyChart = lazy(() => import("@/features/analytics/components/HeavyChart"));

export function DashboardPage() {
  return (
    <Suspense fallback={<ChartSkeleton />}>
      <HeavyChart />
    </Suspense>
  );
}
```

