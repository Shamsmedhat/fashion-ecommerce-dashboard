# Data Fetching & Mutations

## Architecture

All data flows through this pattern:

```
Service function → Custom Hook (useQuery/useMutation) → Component
```

Never call `useQuery` or `useMutation` directly inside a component. Always wrap in a custom hook.

---

## Services — API Call Functions

Services are plain async functions that call the API. No hooks, no side effects.

Place in `src/features/<feature>/services/` if feature-specific, or `src/services/` if shared.

```typescript
// src/features/products/services/product.service.ts
import { AppError } from "@/utils/app-errors";
import { env } from "@/config/env";
import { JSON_HEADER } from "@/config/constants";

export async function getProductsService(params?: QueryParams): Promise<ProductsResponse> {
  const url = new URL(`${env.API_URL}/products`);

  if (params) url.search = buildQueryString(params);

  const response = await fetch(url.toString(), {
    headers: { ...JSON_HEADER },
  });

  if (!response.ok) {
    const errorData: ErrorResponse = await response.json().catch(() => ({
      status: "error" as const,
      message: `Request failed with status ${response.status}`,
    }));
    throw new AppError(errorData.message, response.status);
  }

  return response.json();
}

export async function createProductService(
  input: CreateProductInput
): Promise<Product> {
  const response = await fetch(`${env.API_URL}/products`, {
    method: "POST",
    headers: { ...JSON_HEADER },
    body: JSON.stringify(input),
  });

  if (!response.ok) {
    const errorData: ErrorResponse = await response.json().catch(() => ({
      status: "error" as const,
      message: `Request failed with status ${response.status}`,
    }));
    throw new AppError(errorData.message, response.status);
  }

  return response.json();
}
```

