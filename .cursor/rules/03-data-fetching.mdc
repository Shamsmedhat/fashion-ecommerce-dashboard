## Mutation Hooks (useMutation)

Always handle `onError` with `toast.error()`. Always handle `onSuccess` with cache invalidation.

```typescript
// src/features/products/hooks/use-create-product.ts
import { useMutation, useQueryClient } from "@tanstack/react-query";
import { toast } from "sonner";

import { queryKeys } from "@/config/query-keys";
import { createProductService } from "../services/product.service";
import { getErrorMessage } from "@/utils/catch-error";
import type { CreateProductInput } from "../types/product.d";

export function useCreateProduct() {
  // Queries
  const queryClient = useQueryClient();

  // Mutation
  const { isPending, mutate } = useMutation({
    mutationFn: (input: CreateProductInput) => createProductService(input),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: queryKeys.products.all });
      toast.success("Product created");
    },
    onError: (error) => {
      toast.error(getErrorMessage(error));
    },
  });

  return { isPending, createProduct: mutate };
}
```

